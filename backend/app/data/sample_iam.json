{
  "account_id": "123456789012",
  "principals": [
    {
      "id": "user:alice",
      "arn": "arn:aws:iam::123456789012:user/alice",
      "name": "alice",
      "kind": "User",
      "trust": [],
      "policies": [
        {
          "effect": "Allow",
          "actions": [
            "iam:PassRole",
            "lambda:CreateFunction",
            "lambda:InvokeFunction"
          ],
          "resources": ["*"]
        }
      ]
    },
    {
      "id": "user:bob",
      "arn": "arn:aws:iam::123456789012:user/bob",
      "name": "bob",
      "kind": "User",
      "trust": [],
      "policies": [
        {
          "effect": "Allow",
          "actions": ["iam:CreateAccessKey"],
          "resources": ["arn:aws:iam::123456789012:user/admin-user"]
        }
      ]
    },
    {
      "id": "user:charlie",
      "arn": "arn:aws:iam::123456789012:user/charlie",
      "name": "charlie",
      "kind": "User",
      "trust": [],
      "policies": [
        {
          "effect": "Allow",
          "actions": ["sts:AssumeRole"],
          "resources": ["arn:aws:iam::123456789012:role/operations-admin"]
        }
      ]
    },
    {
      "id": "user:admin-user",
      "arn": "arn:aws:iam::123456789012:user/admin-user",
      "name": "admin-user",
      "kind": "User",
      "trust": [],
      "policies": [
        {
          "effect": "Allow",
          "actions": ["*"],
          "resources": ["*"]
        }
      ]
    },
    {
      "id": "role:dev-role",
      "arn": "arn:aws:iam::123456789012:role/dev-role",
      "name": "dev-role",
      "kind": "Role",
      "trust": ["user:developer"],
      "policies": [
        {
          "effect": "Allow",
          "actions": [
            "iam:AttachRolePolicy",
            "iam:PutRolePolicy"
          ],
          "resources": ["arn:aws:iam::123456789012:role/dev-role"]
        }
      ]
    },
    {
      "id": "role:lambda-admin",
      "arn": "arn:aws:iam::123456789012:role/lambda-admin",
      "name": "lambda-admin",
      "kind": "Role",
      "trust": ["service:lambda.amazonaws.com"],
      "policies": [
        {
          "effect": "Allow",
          "actions": ["*"],
          "resources": ["*"]
        }
      ]
    },
    {
      "id": "role:operations-admin",
      "arn": "arn:aws:iam::123456789012:role/operations-admin",
      "name": "operations-admin",
      "kind": "Role",
      "trust": ["user:charlie"],
      "policies": [
        {
          "effect": "Allow",
          "actions": ["*"],
          "resources": ["*"]
        }
      ]
    }
  ]
}
